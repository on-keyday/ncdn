config.go.package = "edge"
input.endian = config.endian.little

enum LogLevel:
    :u8
    TRACE = "TRACE"
    DEBUG = "DEBUG"
    INFO = "INFO"
    WARN = "WARN"
    ERROR = "ERROR"

enum Protocol:
    :u8
    http1_plain
    http1
    h2
    h3
    other = 0xff

format ProtocolInfo:
    protocol :Protocol
    if protocol == Protocol.other:
        len :u8
        protocol_name :[len]u8

enum Method:
    :u8
    GET = "GET"
    POST = "POST"
    PUT = "PUT"
    HEAD = "HEAD"
    OPTIONS = "OPTIONS"
    PATCH = "PATCH"
    DELETE = "DELETE"
    CONNECT = "CONNECT"
    PRI = "PRI"
    TRACE = "TRACE"
    WELL_KNOWN_MAX
    OTHER = 0xff

format MethodInfo:
    method :Method
    if method == Method.OTHER:
        len :u8
        method_name :[len]u8

format PathInfo:
    path :String
    query_len :u8
    query :[query_len]Field

format String:
    len :u16
    data :[len]u8

format Field:
    key :String
    value :String

format Header:
    len :u16
    fields :[len]Field

format Body:
    offset :u32
    len :u32
    body :[len]u8

format Address:
    is_v6 :u1
    reserved :u7
    if is_v6 == 1:
        addr_v6 :[16]u8
    else:
        addr_v4 :[4]u8

format RequestInfo:
    popID :u32
    reqID :u64
    protocol :ProtocolInfo
    remoteAddr :Address
    remotePort :u16
    method :MethodInfo
    path :PathInfo
    header :Header

format ResponseInfo:
    status :u16
    header :Header

enum DiffDataType:
    :u8
    header # for multiple fields
    field # for single field
    method 
    path
    status
    body
    routing

enum DiffKind:
    :u8
    replace
    insert
    delete

enum Routing:
    :u8
    cont # continue processing
    skip_cache # continue but not using cache even if exists. response may be cached
    no_cache # almost same as skip_cache but response would not be cached
    force_cache # force cache the response even if response not specified to be cached
    skip_response_exec_if_cached # skip on_response hook if response was cached
    deny # do not allowed to access origin, wasm function also can do redirect using this
    abort # disconnect connection, for DoS prevension

format DiffData:
    diff_type :DiffDataType
    kind :DiffKind 
    match diff_type:
        DiffDataType.header => header :Header
        DiffDataType.field => field :Field
        DiffDataType.method => method :MethodInfo
        DiffDataType.path => path :PathInfo
        DiffDataType.status => status :u16
        DiffDataType.body => body :Body
        DiffDataType.routing => routing :Routing

format ChangeSet:
    len :u8
    diff :[len]DiffData

