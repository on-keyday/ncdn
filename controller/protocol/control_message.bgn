
config.go.package = "protocol"

enum ControlMessageType:
    :u8
    l4lb_keepalive # l4lb -> controller
    l7lb_keepalive # l7lb -> controller
    l7lb_hello # l7lb -> controller
    l7lb_update # controller -> l7lb
    l4lb_l7lb_update # controller -> l4lb
    l4lb_hello # l4lb -> controller
    l4lb_update # controller -> l4lb
    key_share # controller -> l4lb,l7lb
    wasm_install # controller -> l7lb
    wasm_uninstall # controller -> l7lb


format ControlMessageHeader:
    version :u8
    version == 0
    len :u16
    message_type :ControlMessageType


format ControlMessage:
    header :ControlMessageHeader
    match header.message_type:
        ControlMessageType.l4lb_keepalive => l4lb_keep_alive :L4LBKeepAlive(input =  input.subrange(header.len))
        ControlMessageType.l7lb_keepalive => l7lb_keep_alive :L7LBKeepAlive(input =  input.subrange(header.len))
        ControlMessageType.l7lb_hello => l7lb_hello :L7LBInfo(input = input.subrange(header.len))
        ControlMessageType.l7lb_update => l7lb_update :L7LBUpdate(input = input.subrange(header.len))
        ControlMessageType.l4lb_hello => l4lb_hello :L4LBInfo(input = input.subrange(header.len))
        ControlMessageType.l4lb_l7lb_update => l4lb_l7lb_update :L4LBL7LBUpdate(input = input.subrange(header.len))
        ControlMessageType.l4lb_update => l4lb_update :L4LBUpdate(input = input.subrange(header.len))
        ControlMessageType.key_share => key_share :KeyShareInfo(input = input.subrange(header.len))
        ControlMessageType.wasm_install => wasm_install :WasmInstallInfo(input = input.subrange(header.len))
        ControlMessageType.wasm_uninstall => wasm_uninstall :WasmUninstallInfo(input = input.subrange(header.len))
        .. => data :[header.len]u8


format L7LBInfo: # currently l4lb can interpret ipv4 only
    server_id :u32 # hashed value, for consistensy hash
    address :[4]u8
    mac_address :[6]u8
    port_len :u8
    port :[port_len]u16

format L7LBUpdate:
    server_id :u32

format L4LBL7LBUpdate:
    len :u8
    info :[len]L7LBInfo

format KeepAliveInfo:
    next_period :u64 # nano sec
    cpu_len :u8
    cpu_usage :[cpu_len]fl64
    memory_usage :fl64
    disk_usage :fl64

format L7LBKeepAlive:
    info :KeepAliveInfo
    rps_len :u8
    rps_per_port :[rps_len]u32

format L4LBKeepAlive:
    info :KeepAliveInfo
    ebpf_len :u8
    ebpf_data :[ebpf_len]u8 # struct stat_counters

format L4LBInfo:
    server_id :u32
    virtual_address :[4]u8
    address :[4]u8
    mac_address :[6]u8

format L4LBUpdate:
    virtual_address :[4]u8

enum KeyType:
    :u8
    quiclb

format KeyShareInfo:
    type :KeyType
    len :u16
    key :[len]u8

format WasmInstallInfo:
    id :u32
    method_len :u8
    method :[method_len]u8
    path_len :u16
    path :[path_len]u8
    binary_size :u64 # followed by single data websocket frame contains webassembly

format WasmUninstallInfo:
    id :u32
