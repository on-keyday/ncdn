
# NOTE: The security model of this protocol is dependent on the underlying transport
#       should use mTLS for LB-Controller connection for production environment

config.go.package = "protocol"

enum ControlMessageType:
    :u8
    cmdline_in # controller -> l4lb,l7lb
    cmdline_out # l4lb,l7lb -> controller
    cmdline_exit # l4lb,l7lb -> controller
    cmdline_instr # controller -> l4lb,l7lb
    cmdline_resize # controller -> l4lb,l7lb
    file_transfer # controller -> l4lb,l7lb
    l4lb_keepalive # l4lb -> controller
    l7lb_keepalive # l7lb -> controller
    l7lb_hello # l7lb -> controller
    l7lb_update # controller -> l7lb
    l4lb_l7lb_update # controller -> l4lb
    l7lb_l4lb_update # controller -> l7lb
    l4lb_hello # l4lb -> controller
    vip_update # controller -> l4lb,l7lb
    key_share # controller -> l4lb,l7lb
    wasm_install # controller -> l7lb
    wasm_uninstall # controller -> l7lb
    message # l4lb,l7lb -> controller
    large_chunk # both direction


format ControlMessageHeader:
    version :u8
    version == 0
    len :u16
    message_type :ControlMessageType




format ControlMessage:
    header :ControlMessageHeader
    match header.message_type:
        ControlMessageType.l4lb_keepalive => l4lb_keep_alive :L4LBKeepAlive(input =  input.subrange(header.len))
        ControlMessageType.l7lb_keepalive => l7lb_keep_alive :L7LBKeepAlive(input =  input.subrange(header.len))
        ControlMessageType.l7lb_hello => l7lb_hello :L7LBHello(input = input.subrange(header.len))
        ControlMessageType.l7lb_update => l7lb_update :L7LBUpdate(input = input.subrange(header.len))
        ControlMessageType.l4lb_hello => l4lb_hello :L4LBHello(input = input.subrange(header.len))
        ControlMessageType.l4lb_l7lb_update => l4lb_l7lb_update :L4LBL7LBUpdate(input = input.subrange(header.len))
        ControlMessageType.l7lb_l4lb_update => l7lb_l4lb_update :L7LBL4LBUpdate(input = input.subrange(header.len))
        ControlMessageType.vip_update => vip_update :VIPUpdate(input = input.subrange(header.len))
        ControlMessageType.key_share => key_share :KeyShareInfo(input = input.subrange(header.len))
        ControlMessageType.wasm_install => wasm_install :WasmInstallInfo(input = input.subrange(header.len))
        ControlMessageType.wasm_uninstall => wasm_uninstall :WasmUninstallInfo(input = input.subrange(header.len))
        ControlMessageType.message => message :Message(input = input.subrange(header.len))
        ControlMessageType.cmdline_in => cmdline_in :CmdlineIn(input = input.subrange(header.len))
        ControlMessageType.cmdline_out => cmdline_out :CmdlineOut(input = input.subrange(header.len))
        ControlMessageType.cmdline_exit => cmdline_exit :CommandExit(input = input.subrange(header.len))
        ControlMessageType.cmdline_resize => cmdline_resize :CmdlineResize(input = input.subrange(header.len))
        ControlMessageType.file_transfer => file_transfer :FileTransfer(input = input.subrange(header.len))
        ControlMessageType.cmdline_instr => cmdline_instr :CmdlineInstruction(input = input.subrange(header.len))
        ControlMessageType.large_chunk => large_chunk :LargeChunkHeader(input = input.subrange(header.len))
        .. => data :[header.len]u8

format MachineInfo:
    cpu_count :u8
    memory_total :u64
    disk_total :u64

format L7LBHello:
    machine :MachineInfo
    info :L7LBInfo

format Address:
    is_v6 :u1
    reserved :u7
    if is_v6 == 1:
        addr_v6 :[16]u8
    else:
        addr_v4 :[4]u8

format L7LBInfo: # currently l4lb can interpret ipv4 only
    server_id :u32 # hashed value, for consistensy hash
    address :Address
    mac_address :[6]u8
    port_len :u8
    port :[port_len]u16

format L4LBHello:
    machine :MachineInfo
    info :L4LBInfo

format L4LBInfo:
    server_id :u32
    address :Address
    mac_address :[6]u8


format L7LBUpdate:
    server_id :u32

format L4LBL7LBUpdate:
    len :u8
    info :[len]L7LBInfo

format L7LBL4LBUpdate:
    len :u8
    info :[len]L4LBInfo

format KeepAliveInfo:
    next_period :u64 # nano sec
    uptime :u64
    cpu_len :u8
    cpu_usage :[cpu_len]fl64
    memory_usage :u64
    disk_usage :u64
    io_utilization :fl64
    load_avg :fl64
    disk_swap :fl64


format L7LBPortInfo:
    handshake_failure :u64
    rps :fl64
    success :u64 # 2xx
    client_failure :u64 # # 4xx
    server_failure :u64 # 5xx
    disconnect :u64 # disconnected by abort
    origin_response_time :u64

format L7LBKeepAlive:
    info :KeepAliveInfo
    throughput :u64
    drop_count :u64
    packet_total :u64
    port_len :u8
    ports :[port_len]L7LBPortInfo

format L4LBKeepAlive:
    info :KeepAliveInfo
    ebpf_len :u8
    ebpf_data :[ebpf_len]u8 # struct stat_counters, serialized by other system


format VIPUpdate:
    virtual_address :Address
    prefix :u8

enum KeyType:
    :u8
    quiclb

format KeyShareInfo:
    type :KeyType
    len :u16
    key :[len]u8

format WasmInstallInfo:
    id :u32
    method_len :u8
    method :[method_len]u8
    path_len :u16
    path :[path_len]u8
    chunk_info :ChunkInfo

format WasmUninstallInfo:
    id :u32

enum LogLevel:
    :u8
    TRACE = "TRACE"
    DEBUG = "DEBUG"
    INFO = "INFO"
    WARN = "WARN"
    ERROR = "ERROR"

format Message:
    level :LogLevel
    msg_len :u16
    msg :[msg_len]u8


enum CmdInstructionType:
    :u8
    use_pty # enable pty. should send before first CmdlineIn. stderr will be merged into stdout
    close_stdin
    kill # takes arg that signal number + 1. if 0, default behaviour
    kill_all # ignore cmdline_id and kill all managed process (for resetting)


format CmdlineInstruction:
    cmdline_id :u32
    instr :CmdInstructionType
    arg :u8 # instruction argument

format CmdlineIn: # initial CmdlineIn message will be command line, later ones will be stdin
    cmdline_id :u32
    len :u16
    cmdline :[len]u8

format CmdlineResize:
    cmdline_id :u32
    col :u16
    row :u16

enum OutputType:
    :u8
    stdout
    stderr

format ChunkInfo:
    is_chunkd :u1
    len_or_id :u31

format CmdlineOut:
    cmdline_id :u32
    output_type :OutputType
    chunk_info :ChunkInfo

format CommandExit:
    cmdline_id :u32
    exit_code :u32

format FileTransfer:
    path_len :u16
    path :[path_len]u8
    permission :u16
    chunk_info :ChunkInfo

format LargeChunkHeader:
    eof :u1
    chunk_id :u31
    chunk_len :u32
